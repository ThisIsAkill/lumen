[Unit]
Description=Lumen snippet expansion helper (reports typed snippet keywords to Lumen)

[Service]
ExecStart=/usr/local/libexec/lumen-expand-helper
RuntimeDirectory=lumen-expand
RuntimeDirectoryMode=0755
Restart=on-failure

# It only reads keyboards and serves one socket: take everything else away.
CapabilityBoundingSet=CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-input r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
